# MongoDB connection string. When unset, Swara-Setu falls back to an
# in-memory seed loader so the live demo never crashes during judge testing.
MONGODB_URI=

# Google Gemini API key, used by the AI linguistic verification pipeline
# (submission validation + auto-transliteration fallback).
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: app display name / hackathon metadata
APP_NAME=Swara-Setu