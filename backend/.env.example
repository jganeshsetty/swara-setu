# ==============================================================================
# Swara-Setu Backend Environment Configuration (Template)
# ==============================================================================

# Bhashini AI API Credentials (for Native Kannada Speech-to-Text & Text-to-Speech)
# Request your credentials from: https://bhashini.gov.in/ulca
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_INFERENCE_TOKEN=your_bhashini_inference_token_here

# NVIDIA NIM API (for Fast Kannada LLM RAG & Dialect Generation)
# Get your key from: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Hugging Face Access Token (Optional fallback)
HUGGINGFACEHUB_API_TOKEN=your_hugging_face_token_here
